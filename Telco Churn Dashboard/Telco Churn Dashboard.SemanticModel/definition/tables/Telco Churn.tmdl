table 'Telco Churn'
	lineageTag: b97ca4e0-f3e8-4a2f-9d67-40224988b742

	/// Distinct count of customer identifiers in the current filter context.
	measure 'Total Customers' = DISTINCTCOUNT('Telco Churn'[customerID])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 677f1bab-76cc-46ab-b287-d0d559701e68

	/// Number of churned customer rows in the current filter context.
	measure 'Churned Customers' = SUM('Telco Churn'[Churn Flag])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 56665dc0-49b1-4cb1-99e7-d3d518ef140d

	/// Churned customers divided by total customers in the current filter context.
	measure 'Churn Rate %' = DIVIDE([Churned Customers], [Total Customers], 0)
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 930f010a-0976-4aa5-b33f-5a9bab64a40d

	/// Average monthly charge for customers in the current filter context.
	measure 'Avg Monthly Charges' = AVERAGE('Telco Churn'[MonthlyCharges])
		formatString: \$#,0.00
		displayFolder: Measures
		lineageTag: 4c42a275-4d03-44fe-96bb-f7f1e51b3ceb

	/// Average customer tenure in months in the current filter context.
	measure 'Avg Tenure' = AVERAGE('Telco Churn'[tenure])
		formatString: 0.0
		displayFolder: Measures
		lineageTag: 4c248973-4b86-4755-95d2-d36e01bbb5a9

	/// Sum of monthly charges associated with churned customers in the current filter context.
	measure 'Revenue at Risk' = CALCULATE(SUM('Telco Churn'[MonthlyCharges]), KEEPFILTERS('Telco Churn'[Churn] = "Yes"))
		formatString: \$#,0.00
		displayFolder: Measures
		lineageTag: 47b6cb0c-d280-4c53-af8a-9cc1e37964ff

	/// Current-context churn rate minus the unfiltered overall churn rate.
	measure 'Churn Rate vs Overall' =
			VAR OverallChurnRate =
				CALCULATE(
					[Churn Rate %],
					REMOVEFILTERS('Telco Churn')
				)
			RETURN
				[Churn Rate %] - OverallChurnRate
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Measures
		lineageTag: 70a3743c-bb2d-4833-84ef-f866def78649

	/// Source row count after Power Query transformations.
	measure 'Data Rows' = COUNTROWS('Telco Churn')
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: d4e038f8-09e8-4d46-b5cd-c5887b6f7dc8

	/// Blank customer identifiers after import.
	measure 'Null Customer IDs' = COALESCE(COUNTBLANK('Telco Churn'[customerID]), 0)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 9c3d3265-dafc-4160-a56b-5a8c402ea977

	/// Rows beyond the distinct customer identifier count.
	measure 'Duplicate Customer IDs' = COUNTROWS('Telco Churn') - DISTINCTCOUNT('Telco Churn'[customerID])
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 2a2d8bc8-a288-49a0-856e-87b50d816a57

	/// Blank tenure values after import.
	measure 'Null Tenure' = COALESCE(COUNTBLANK('Telco Churn'[tenure]), 0)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 4e55863a-1830-4789-89c9-af095a1e0c4a

	/// Blank monthly charge values after import.
	measure 'Null Monthly Charges' = COALESCE(COUNTBLANK('Telco Churn'[MonthlyCharges]), 0)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f7fd1f8b-8da0-4280-b087-7f5ba66e62f4

	/// Blank TotalCharges values after the tenure-zero correction.
	measure 'Null Total Charges' = COALESCE(COUNTBLANK('Telco Churn'[TotalCharges]), 0)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: 4b1062c3-85cf-4b9e-9c5d-dd3b9988708a

	/// Blank churn labels after import.
	measure 'Null Churn' = COALESCE(COUNTBLANK('Telco Churn'[Churn]), 0)
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f36b54dc-6010-4165-9471-c2ccd7d38232

	/// Customers with zero completed months of service.
	measure 'Tenure Zero Customers' = CALCULATE(COUNTROWS('Telco Churn'), KEEPFILTERS('Telco Churn'[tenure] = 0))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: f699b90a-5238-43dc-9375-1d218c1ff501

	/// Customers whose accumulated charges are zero after the correction.
	measure 'Zero Total Charges' = CALCULATE(COUNTROWS('Telco Churn'), KEEPFILTERS('Telco Churn'[TotalCharges] = 0))
		formatString: #,0
		displayFolder: Data Quality
		lineageTag: c9b875dc-85f7-429f-abb9-926f05f5b463

	/// Overall status for the dashboard's documented quality checks.
	measure 'Data Quality Status' =
			VAR NullOrDuplicateIssues =
				[Null Customer IDs]
					+ [Duplicate Customer IDs]
					+ [Null Tenure]
					+ [Null Monthly Charges]
					+ [Null Total Charges]
					+ [Null Churn]
			VAR TotalChargesFixMismatch =
				ABS([Tenure Zero Customers] - [Zero Total Charges])
			RETURN
				IF(NullOrDuplicateIssues = 0 && TotalChargesFixMismatch = 0, "PASS", "REVIEW")
		displayFolder: Data Quality
		lineageTag: cdf2a304-8f23-4781-abe3-bb3e2063dd5a

